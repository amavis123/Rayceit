# For local dev, run `npx prisma dev` from apps/backend — it starts a local
# Postgres for you and prints a connection string to use here. No install,
# no account needed.
DATABASE_URL=postgres://postgres:postgres@localhost:51214/template1?sslmode=disable
PORT=3001

CLERK_SECRET_KEY=sk_test_xxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx

CUSTOMER_APP_URL=http://localhost:3002
MERCHANT_APP_URL=http://localhost:3003

STRIPE_SECRET_KEY=sk_test_xxxxxxxx

# Generate your own with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
